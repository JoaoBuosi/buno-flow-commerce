# Use chaves aleatorias longas e distintas. Arquivo .env nunca vai para o Git.
BUNO_TENANT_ID=loja-demonstracao
BUNO_STORE_API_KEY=REPLACE_WITH_RANDOM_STORE_KEY
BUNO_CORE_API_KEY=REPLACE_WITH_RANDOM_CORE_EXECUTOR_KEY
BUNO_CORE_URL=http://buno-core:8000
BUNO_CORE_READ_KEY=REPLACE_WITH_RANDOM_CORE_READER_KEY
# Para Supabase, passe JDBC com sslmode=require exclusivamente no backend.
# SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=...
# SPRING_DATASOURCE_PASSWORD=...
# HIBERNATE_DDL_AUTO=validate
