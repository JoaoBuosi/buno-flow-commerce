# Copie para .env (nao commitado) e substitua por 4 chaves aleatorias DIFERENTES (min. 24 caracteres).
BUNO_TENANT_ID=loja-demonstracao
BUNO_STORE_API_KEY=REPLACE_WITH_RANDOM_STORE_KEY
BUNO_AGENT_API_KEY=REPLACE_WITH_RANDOM_AGENT_KEY
BUNO_APPROVER_API_KEY=REPLACE_WITH_RANDOM_APPROVER_KEY
BUNO_CORE_API_KEY=REPLACE_WITH_RANDOM_CORE_KEY

